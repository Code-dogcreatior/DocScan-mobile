# 复制为 env/app.env 后填写，然后：
#   flutter run --dart-define-from-file=env/app.env
#
# MATTING_API_BASE：抠图 HTTP 根地址（无尾斜杠）
# INPAINT_API_BASE：AI 擦除 HTTP 根地址（默认 POST {base}/inpaint）
# OPENROUTER_*：公式云端识别与解题（可选，不填则仅用 ONNX）
# 是否联网由系统 connectivity 判断，不再请求探测 URL。

MATTING_API_BASE=
INPAINT_API_BASE=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://llm.onerouter.pro/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
# 以下留空则与 OPENROUTER_MODEL 相同；可单独指定文字识别 / 翻译 / 物体识别模型
OPENROUTER_MODEL_TEXT_OCR=
OPENROUTER_MODEL_TRANSLATE=
OPENROUTER_MODEL_OBJECT=
